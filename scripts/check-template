#!/bin/bash

# Renders the template for two representative projects (one without a bundled
# client, one with) into temporary folders and checks what can be checked
# without a real integration around it:
#
#   - the shell scripts pass ShellCheck, and the generated ones parse;
#   - pyproject.toml is valid TOML and `uv lock` resolves it (this is what
#     caught a requires-python that homeassistant's own floor made unsatisfiable);
#   - the lint/test scopes the scripts report match the project's shape;
#   - the commit-msg hook is installed and applies .commitlintrc.mjs.
#
# It does NOT run the linters or the tests: those need real integration code.
# Usage: scripts/check-template   (needs copier and uv on PATH)

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

render() {
  local name="$1"
  shift
  local dest="$work/$name"
  mkdir -p "$dest/custom_components/demo" "$dest/tests"
  touch "$dest/README.md"
  git -C "$dest" init -q
  copier copy --quiet --trust --defaults --overwrite --vcs-ref=HEAD \
    -d integration_domain=demo -d integration_name=Demo -d description="Demo integration" \
    "$@" "$root" "$dest"
  echo "$dest"
}

check_common() {
  local dest="$1"
  for script in "$dest"/scripts/_common "$dest"/scripts/lint "$dest"/scripts/test "$dest"/scripts/setup "$dest"/scripts/develop; do
    bash -n "$script" || fail "$script does not parse"
  done
  python3 -c "import json, sys; d = json.load(open(sys.argv[1])); assert d['workspaceFolder'] in d['workspaceMount']" \
    "$dest/.devcontainer/devcontainer.json" || fail "devcontainer.json: workspaceMount and workspaceFolder disagree"
  python3 -c "import sys, tomllib; tomllib.load(open(sys.argv[1], 'rb'))" "$dest/pyproject.toml" \
    || fail "pyproject.toml is not valid TOML"
  "$dest/scripts/clean_bruno_headers" --check > /dev/null || fail "clean_bruno_headers fails on a project without a Bruno collection"
  # Prettier must leave Copier's own answers file alone, or each `copier update` would fight it.
  if command -v npx > /dev/null 2>&1; then
    (cd "$dest" && git add -A && scripts/lint repo > /dev/null && git diff --quiet -- .copier-answers.yml) \
      || fail "scripts/lint repo rewrites .copier-answers.yml"
  fi
  (cd "$dest" && uv lock) || fail "uv lock cannot resolve pyproject.toml"
  grep -qx 'name = "copier"' "$dest/uv.lock" || fail "copier is not in the locked environment (needed for uv run copier update)"
}

echo "== markdown formatting"
# Generated markdown is copied as is into every repository, where `scripts/lint repo`
# runs Prettier: anything not already formatted would be rewritten there.
if command -v npx > /dev/null 2>&1; then
  (cd "$root" && npx --yes prettier@3.6.2 --check README.md "template/**/*.md") \
    || fail "markdown files are not formatted with Prettier"
else
  echo "npx not found: skipped"
fi

echo "== shellcheck"
# The bash scripts, picked by their first line (a bash shebang, or the shell
# directive of _common, which is sourced rather than run): a new script is
# checked without being listed here, and the Python ones are left out. Run from
# the folder holding scripts/, where `# shellcheck source=scripts/_common`
# resolves. Pinned through PyPI, so that CI and a local run agree.
shellcheck_scripts() {
  (cd "$1" && grep -lE '^(#!/bin/bash|# shellcheck shell=bash.*)$' scripts/* \
    | xargs uvx --quiet --from shellcheck-py==0.11.0.1 shellcheck --external-sources)
}
shellcheck_scripts "$root/template" || fail "ShellCheck reports problems in template/scripts"
shellcheck_scripts "$root" || fail "ShellCheck reports problems in scripts"

echo "== without a client"
dest="$(render plain)"
check_common "$dest"
[ "$("$dest/scripts/lint" --list-scopes)" = '["integration", "tests"]' ] || fail "unexpected lint scopes (plain)"
[ "$("$dest/scripts/test" --list-scopes)" = '["integration"]' ] || fail "unexpected test scopes (plain)"
[ ! -e "$dest/.coveragerc-integration" ] || fail ".coveragerc-integration generated without a client"

# Fixed choices of the template, checked on the rendered project.
for workflow in lint test; do
  grep -q 'pull-requests: read' "$dest/.github/workflows/$workflow.yml" \
    || fail "$workflow.yml: the changes job lacks pull-requests: read (dorny/paths-filter fails without it)"
done
[ -f "$dest/.github/workflows/stale.yml" ] || fail "stale.yml is missing"
[ -f "$dest/.github/workflows/sync-labels.yml" ] || fail "sync-labels.yml is missing"
python3 - "$dest/.github/labels.json" <<'PY' || fail "labels.json is not a valid label list"
import json, re, sys
labels = json.load(open(sys.argv[1]))
names = [label["name"] for label in labels]
assert names and len(names) == len(set(names)), "empty or duplicated names"
for label in labels:
    assert set(label) == {"name", "color", "description"}, label
    assert re.fullmatch(r"[0-9a-f]{6}", label["color"]), label
    assert label["description"], label
PY
# The LICENSE notice starts at the year Copier was asked for, the current year by default.
grep -qx "Copyright (c) $(date +%Y) Jane Doe" "$dest/LICENSE" || fail "LICENSE does not carry the current year and the default author"
for template in config.yml feature_request.md bug_report.md; do
  [ -f "$dest/.github/ISSUE_TEMPLATE/$template" ] || fail "issue template $template is missing"
done
grep -qx '\*\*Demo version:\*\*' "$dest/.github/ISSUE_TEMPLATE/bug_report.md" || fail "bug_report.md does not name the integration"
grep -qx '"""Tests for the Demo Home Assistant integration."""' "$dest/tests/__init__.py" \
  || fail "tests/__init__.py does not name the integration"
grep -qx 'DOMAIN = "demo"' "$dest/tests/test_integration_loads.py" || fail "the first test does not name the domain"
# No client: tests/ forbids an Args section, the one the client variant of conftest.py carries.
! grep -q 'Args:' "$dest/tests/conftest.py" || fail "conftest.py documents arguments without a client"
# Every label an issue template applies must be one the labels workflow creates.
python3 - "$dest/.github" <<'PY' || fail "an issue template uses a label missing from labels.json"
import json, pathlib, re, sys
root = pathlib.Path(sys.argv[1])
known = {label["name"] for label in json.load(open(root / "labels.json"))}
for template in (root / "ISSUE_TEMPLATE").glob("*.md"):
    used = re.search(r"^labels: \[(.*)\]$", template.read_text(), re.MULTILINE)
    assert used, template.name
    for name in re.findall(r'"([^"]+)"', used.group(1)):
        assert name in known, (template.name, name)
PY
# The bug report and the seeded tests belong to the repository once created: a
# new render keeps them.
printf 'local bug report\n' > "$dest/.github/ISSUE_TEMPLATE/bug_report.md"
for seeded in __init__.py conftest.py test_integration_loads.py; do
  printf '"""Local %s."""\n' "$seeded" > "$dest/tests/$seeded"
done
copier copy --quiet --trust --defaults --overwrite --vcs-ref=HEAD \
  -d integration_domain=demo -d integration_name=Demo -d description="Demo integration" "$root" "$dest"
grep -qx 'local bug report' "$dest/.github/ISSUE_TEMPLATE/bug_report.md" || fail "a new render overwrote bug_report.md"
for seeded in __init__.py conftest.py test_integration_loads.py; do
  grep -qx "\"\"\"Local $seeded.\"\"\"" "$dest/tests/$seeded" || fail "a new render overwrote tests/$seeded"
done
mkdir -p "$dest/card" "$dest/custom_components/demo/pyclient/bruno"
printf '{"a":   1}\n' > "$dest/card/vendored.json"
printf '{"a":   1}\n' > "$dest/custom_components/demo/pyclient/bruno/collection.json"
if command -v npx > /dev/null 2>&1; then
  (cd "$dest" && scripts/lint repo > /dev/null)
  grep -q '"a":   1' "$dest/card/vendored.json" || fail "scripts/lint repo reformatted card/"
  grep -q '"a":   1' "$dest/custom_components/demo/pyclient/bruno/collection.json" || fail "scripts/lint repo reformatted a bruno/ folder"
fi
grep -q 'bruno' "$dest/.pre-commit-config.yaml" || fail "pre-commit does not skip bruno/ folders"
# The commit-msg hook, run through the prek release pyproject.toml pins: `prek
# install` (scripts/setup) must write it, and the commitlint release it pins
# must load .commitlintrc.mjs, accept a message that follows it and reject one
# that does not - for the rule's reason, not because the hook failed to start.
prek="$(grep -o '"prek==[^"]*"' "$dest/pyproject.toml" | tr -d '"')"
(cd "$dest" && git add -A && uvx --quiet --from "$prek" prek install > /dev/null) \
  && [ -f "$dest/.git/hooks/commit-msg" ] || fail "prek install does not install the commit-msg hook"
if command -v node > /dev/null 2>&1; then
  printf 'chore: check the commit message hook\n' > "$work/good-message"
  printf 'chore: too short\n' > "$work/bad-message"
  (cd "$dest" && uvx --quiet --from "$prek" prek run commitlint --hook-stage commit-msg \
    --commit-msg-filename "$work/good-message" > /dev/null) || fail "the commit-msg hook rejects a valid message"
  rejected="$(cd "$dest" && uvx --quiet --from "$prek" prek run commitlint --hook-stage commit-msg \
    --commit-msg-filename "$work/bad-message" 2>&1 || true)"
  grep -q 'subject-min-length' <<< "$rejected" || fail "the commit-msg hook does not apply .commitlintrc.mjs"
else
  echo "node not found: commit-msg hook not run"
fi

echo "== with a client"
dest="$(render client -d client_package=pydemo -d copyright_year=2024 -d author_name="Bastien Gautier" -d author_email=contact@bastiengautier.com -d github_owner=bastgau)"
check_common "$dest"
[ "$("$dest/scripts/lint" --list-scopes)" = '["client", "integration", "tests"]' ] || fail "unexpected lint scopes (client)"
[ "$("$dest/scripts/test" --list-scopes)" = '["client", "integration"]' ] || fail "unexpected test scopes (client)"
[ -e "$dest/.coveragerc-integration" ] || fail ".coveragerc-integration missing with a client"
# With a client, docstring-linter requires the conftest fixture's arguments to be documented.
grep -q 'Args:' "$dest/tests/conftest.py" || fail "conftest.py does not document its arguments with a client"
grep -qx "Copyright (c) 2024 Bastien Gautier" "$dest/LICENSE" || fail "LICENSE ignores copyright_year or author_name"
python3 -c "import sys, tomllib; p = tomllib.load(open(sys.argv[1], 'rb'))['project']; assert p['authors'] == p['maintainers'] == [{'name': 'Bastien Gautier', 'email': 'contact@bastiengautier.com'}], p" \
  "$dest/pyproject.toml" || fail "pyproject.toml ignores author_name or author_email"
python3 -c "import sys, tomllib; urls = tomllib.load(open(sys.argv[1], 'rb'))['project']['urls']; assert all(u.startswith('https://github.com/bastgau/') for u in urls.values()), urls" \
  "$dest/pyproject.toml" || fail "pyproject.toml URLs ignore github_owner"
for command in create-develop-pull-request create-main-pull-request; do
  # The backticks are markdown, matched as they are: not a command substitution.
  # shellcheck disable=SC2016
  grep -q 'assigned to `bastgau`' "$dest/.claude/commands/$command.md" || fail "$command.md ignores github_owner"
  ! grep -q janedoe "$dest/.claude/commands/$command.md" || fail "$command.md still names the default owner"
done

echo "OK"
