#!/bin/bash

# Installs what working on this template needs: python3 (scripts/install-python),
# Node.js for npx (scripts/install-node), uv (scripts/install-uv) and Copier as a
# uv tool (scripts/install-copier). Safe to re-run.
# Usage: scripts/setup   (Linux, macOS, WSL; needs curl and git)

set -euo pipefail

fail() { echo "FAIL: $*" >&2; exit 1; }

command -v git > /dev/null 2>&1 || fail "git is not installed (Copier needs it)"

scripts_dir="$(dirname "$0")"

"$scripts_dir/install-python" || fail "python3 could not be installed"
"$scripts_dir/install-node" || fail "Node.js (npx) could not be installed"

"$scripts_dir/install-uv" || fail "uv could not be installed"
# Each script runs in its own process, so the PATH they set does not reach this one.
export PATH="$HOME/.local/bin:$PATH"

"$scripts_dir/install-copier" || fail "Copier could not be installed"

echo
echo "Done. Open a new shell (or run: export PATH=\"\$HOME/.local/bin:\$PATH\") then:"
echo "  copier copy gh:bastgau/ha-dev-environment <target>"
echo "  copier update"
