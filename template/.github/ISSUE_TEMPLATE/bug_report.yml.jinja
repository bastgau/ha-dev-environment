{%- set extra = _external_data.issue_extra | default({}, true) -%}
name: 🐞 Bug report
description: Report an issue
labels: ["issue:bug", "issue:triage"]
body:
  - type: markdown
    attributes:
      value: "**Warning:** {{ integration_name }} requires Home Assistant {{ ha_minimum_version }} or later. Reports from older versions cannot be handled."
{%- if extra.get('bug_report_top') %}
{{ extra.bug_report_top | to_nice_yaml(indent=2, sort_keys=False) | indent(2, true) | trim('\n') }}
{%- endif %}
  - type: input
    attributes:
      label: Home Assistant version
      description: Please specify your Home Assistant version.
    validations:
      required: true
  - type: input
    attributes:
      label: {{ integration_name }} version
      description: Please specify your integration version.
    validations:
      required: true
{%- if extra.get('bug_report_versions') %}
{{ extra.bug_report_versions | to_nice_yaml(indent=2, sort_keys=False) | indent(2, true) | trim('\n') }}
{%- endif %}
  - type: textarea
    attributes:
      label: Describe the bug
      description: A clear and concise description of what the bug is.
    validations:
      required: true
  - type: textarea
    attributes:
      label: Expected behavior
      description: A clear and concise description of what you expected to happen.
    validations:
      required: true
  - type: textarea
    attributes:
      label: Screenshots
      description: If applicable, add screenshots to help explain your problem.
  - type: textarea
    attributes:
      label: Additional context
      description: Add any other context about the problem here.
