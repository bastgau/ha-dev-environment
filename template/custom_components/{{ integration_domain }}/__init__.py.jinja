"""The {{ integration_name }} integration.

A minimal skeleton, seeded once by the template: the repository owns it from here on.
Add the setup code (a config flow, platforms) here and in the modules next to it.
"""
{%- if has_card %}

from typing import Final

from homeassistant.core import HomeAssistant
from homeassistant.helpers import config_validation as cv
from homeassistant.helpers.typing import ConfigType

from .card import async_register_card
{%- endif %}

DOMAIN = "{{ integration_domain }}"
{%- if has_card %}

# Home Assistant looks this name up; hassfest requires it next to ``async_setup``. Use
# ``cv.config_entry_only_config_schema(DOMAIN)`` instead once the integration has a config flow.
CONFIG_SCHEMA: Final = cv.empty_config_schema(DOMAIN)  # pylint: disable=invalid-name  # pyright: ignore[reportUnknownVariableType, reportUnknownMemberType]


async def async_setup(hass: HomeAssistant, config: ConfigType) -> bool:  # noqa: ARG001
    """Serve the Lovelace card, once per Home Assistant run.

    Args:
        hass (HomeAssistant): The Home Assistant instance.
        config (ConfigType): The YAML configuration, unused.

    Returns:
        bool: ``True`` always.

    """
    await async_register_card(hass)
    return True
{%- endif %}
