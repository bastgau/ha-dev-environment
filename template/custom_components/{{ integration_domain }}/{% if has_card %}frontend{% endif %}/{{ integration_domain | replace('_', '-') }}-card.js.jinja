// A placeholder Lovelace card for the {{ integration_name }} integration: it only shows the name of the
// integration. Replace it with your own card; custom_components/{{ integration_domain }}/card.py serves it and adds it to every
// dashboard, so it needs no dashboard resource. Add it from the card picker or in YAML:
//
//   type: custom:{{ integration_domain | replace('_', '-') }}-card
//
// JavaScript is checked by `scripts/lint js` (node --check, ESLint, Prettier) and by the `javascript` CI job.

const NAME = {{ integration_name | tojson }};

class {{ integration_domain.split('_') | map('capitalize') | join('') }}Card extends HTMLElement {
  setConfig(config) {
    this._config = config;
    this._render();
  }

  set hass(hass) {
    this._hass = hass;
    this._render();
  }

  getCardSize() {
    return 1;
  }

  _render() {
    if (!this._config) return;
    if (!this._card) {
      this._card = document.createElement("ha-card");
      this.appendChild(this._card);
    }
    this._card.header = this._config.title ?? NAME;
  }
}

if (!customElements.get("{{ integration_domain | replace('_', '-') }}-card")) {
  customElements.define("{{ integration_domain | replace('_', '-') }}-card", {{ integration_domain.split('_') | map('capitalize') | join('') }}Card);
}

window.customCards = window.customCards || [];
if (!window.customCards.some((card) => card.type === "{{ integration_domain | replace('_', '-') }}-card")) {
  window.customCards.push({
    type: "{{ integration_domain | replace('_', '-') }}-card",
    name: NAME + " card",
    description: "A placeholder card of the " + NAME + " integration.",
  });
}
